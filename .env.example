# Copie este arquivo para .env (que fica fora do Git) e troque pelos valores reais.

# String de conexão da Neon (botão "Connect" no painel).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Só para a API: segredo que assina os tokens de login (pelo menos 32 caracteres).
# Gere um com:  openssl rand -base64 48
JWT_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# Opcional: fuso horário usado pela API para os horários dos remédios (padrão: America/Sao_Paulo).
# APP_TIMEZONE=America/Sao_Paulo

# Opcional: "esqueci minha senha" por e-mail, pela Brevo (API HTTPS; o Render gratuito bloqueia SMTP).
# Sem as duas primeiras, o envio fica desligado. Detalhes na ADR-0063.
# EMAIL_BREVO_CHAVE=chave-de-api-da-brevo
# EMAIL_REMETENTE=seu-email-validado-na-brevo@exemplo.com
# EMAIL_NOME_REMETENTE=CuidaMed
# URL_PUBLICA=https://sistema-de-acompanhamento-de-medicamentos.onrender.com
